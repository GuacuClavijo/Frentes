
/* V46 layout/interaction patch */
.graph-wrap{overflow:hidden!important}
#axis{position:relative!important;min-height:224px!important;cursor:grab!important;touch-action:none!important;user-select:none!important}
#axis.dragging{cursor:grabbing!important}
.lane-le{position:absolute!important;inset:0!important;height:224px!important}
.lane-ld{display:none!important}
.graph-band{position:absolute!important;left:0!important;right:0!important;border:0!important;border-radius:0!important;overflow:visible!important}
.band-release,.band-terrap{background:transparent!important}
.band-axis{background:rgba(255,255,255,.98)!important;border-top:2px solid #dbe3ec!important;border-bottom:2px solid #dbe3ec!important}
.release-part{background:rgba(34,197,94,.55)!important;opacity:1!important;border:0!important}
.release-unreleased{background:rgba(239,68,68,.55)!important;opacity:1!important;border:0!important}
.release-part.partial{background:rgba(234,179,8,.55)!important}
.item{opacity:.96!important}
.station-name{writing-mode:vertical-rl!important;transform:rotate(180deg)!important;white-space:nowrap!important;bottom:100%!important;left:50%!important}
.chart-side-label{position:absolute!important;z-index:50!important;left:8px!important;background:#1f4e79!important;color:#fff!important;padding:2px 5px!important;border-radius:3px!important;font-weight:800!important}
.chart-side-label.le{top:4px!important}.chart-side-label.ld{bottom:4px!important}
